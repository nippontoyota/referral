generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VehicleModel {
  glanza
  hyryder
}

enum SendJobStatus {
  pending
  running
  completed
  failed
}

enum SendMessageStatus {
  pending
  sent
  failed
}

enum ImportStatus {
  completed
  failed
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  referralToken String   @unique @map("referral_token")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  referrals     Referral[]
  sendMessages  SendMessage[]

  @@map("customers")
}

model CustomerImport {
  id            String       @id @default(cuid())
  filename      String
  acceptedCount Int          @map("accepted_count")
  rejectedCount Int          @map("rejected_count")
  status        ImportStatus
  createdAt     DateTime     @default(now()) @map("created_at")

  @@map("customer_imports")
}

model SendJob {
  id          String        @id @default(cuid())
  status      SendJobStatus @default(pending)
  total       Int           @default(0)
  sent        Int           @default(0)
  failed      Int           @default(0)
  startedAt   DateTime?     @map("started_at")
  completedAt DateTime?     @map("completed_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  messages    SendMessage[]

  @@map("send_jobs")
}

model SendMessage {
  id         String            @id @default(cuid())
  jobId      String            @map("job_id")
  job        SendJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customerId String?           @map("customer_id")
  customer   Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  phone      String
  status     SendMessageStatus @default(pending)
  attempts   Int               @default(0)
  lastError  String?           @map("last_error")
  sentAt     DateTime?         @map("sent_at")
  createdAt  DateTime          @default(now()) @map("created_at")

  @@index([jobId, status])
  @@map("send_messages")
}

model Referral {
  id                 String       @id @default(cuid())
  referrerCustomerId String?      @map("referrer_customer_id")
  referrer           Customer?    @relation(fields: [referrerCustomerId], references: [id], onDelete: SetNull)
  referrerName       String       @map("referrer_name")
  referrerPhone      String       @map("referrer_phone")
  referredName       String       @map("referred_name")
  referredPhone      String       @map("referred_phone")
  model              VehicleModel
  isDuplicate        Boolean      @default(false) @map("is_duplicate")
  duplicateCount     Int          @default(1) @map("duplicate_count")
  createdAt          DateTime     @default(now()) @map("created_at")

  @@index([referredPhone])
  @@map("referrals")
}
